# TEMPLATE pour .streamlit/secrets.toml (EN LOCAL UNIQUEMENT)
# 
# Ce fichier est un EXEMPLE. Ne commitez PAS secrets.toml réel sur GitHub.
# 
# Pour développer localement avec Google Sheets, créez un fichier .streamlit/secrets.toml
# avec le contenu de credentials.json, OU gardez credentials.json dans le dossier racine.

[general]
# Option 1: Copier le contenu complet de credentials.json ici
# GOOGLE_CREDENTIALS = """
# {
#   "type": "service_account",
#   "project_id": "unique-hour-385920",
#   "private_key_id": "...",
#   ...
# }
# """

# Option 2 (RECOMMANDÉE EN LOCAL): Garder credentials.json dans le dossier racine
# (l'app le trouvera automatiquement via CREDENTIALS_FILE)

# Sur Streamlit Cloud: configurez GOOGLE_CREDENTIALS via l'interface Web
